{
  "expo": {
    "name": "Hearth",
    "slug": "hearth",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "hearth",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.senseibles.hearth",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Hearth uses the camera so you can take a photo to send in a message.",
        "NSMicrophoneUsageDescription": "Hearth uses the microphone so you can record voice notes and video messages.",
        "NSPhotoLibraryUsageDescription": "Hearth lets you choose photos and videos to send in a message.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.senseibles.hearth",
      "adaptiveIcon": {
        "backgroundColor": "#F6F1E7",
        "foregroundImage": "./assets/icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F1E7",
          "dark": { "backgroundColor": "#121512" },
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
