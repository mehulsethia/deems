# RevenueCat public SDK keys (Project settings > API keys). Leave blank for dev mode (everything unlocked).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Required by the App Store before submission.
EXPO_PUBLIC_PRIVACY_URL=
# Optional; defaults to Apple's standard EULA.
EXPO_PUBLIC_TERMS_URL=
# Milestone 5: where newer rules packs are hosted.
RULES_BASE_URL=
